NODE_ENV=development
QTS_API_HOST=127.0.0.1
QTS_API_PORT=8080
QTS_TRUST_PROXY_HOPS=0
QTS_PUBLIC_ORIGIN=http://localhost:5173
QTS_AUTH_COOKIE_SECURE=false

QTS_POSTGRES_PASSWORD=
QTS_DATABASE_URL=postgresql://qts:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/qts_portal
QTS_MIGRATION_DATABASE_URL=
QTS_DATABASE_SSL=false
QTS_DATABASE_POOL_MAX=10
QTS_DATABASE_IDLE_TIMEOUT_MS=30000
QTS_DATABASE_CONNECT_TIMEOUT_MS=5000
QTS_DATA_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=

QTS_AUTH_MEMBERSHIPS_JSON=[]
QTS_AUTH_TRANSACTION_TTL_SECONDS=600
QTS_SESSION_TTL_SECONDS=28800
